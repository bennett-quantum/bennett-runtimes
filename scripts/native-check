#!/usr/bin/env python3
"""Build/run the major-matched comparison-only adapter, outside device identity."""
from pathlib import Path
import hashlib
import os
import shlex
import subprocess
import sys
if len(sys.argv)!=4 or sys.argv[1] not in ('18','23'):
    sys.exit('usage: native-check 18|23 MATERIALISED.bc CHECKED.bc')
if Path(sys.argv[2]).resolve()==Path(sys.argv[3]).resolve():
    sys.exit('native check requires a separate output; materialised input must remain unchanged')
for key in ('DISPLAY','WAYLAND_DISPLAY','DBUS_SESSION_BUS_ADDRESS','BROWSER'):
    os.environ.pop(key,None)
root=Path(__file__).resolve().parents[1]
llvm=Path(os.environ.get(f'BENNETT_LLVM{sys.argv[1]}_BIN', f'/usr/lib/llvm-{sys.argv[1]}/bin'))
source=root/'scripts/native-check.cpp'
scratch=Path(os.environ.get('TMPDIR',root/'.tmp'))/'native-check'
scratch.mkdir(parents=True,exist_ok=True)
flags=shlex.split(subprocess.check_output([llvm/'llvm-config','--cxxflags','--ldflags',
                 '--libs','core','irreader','bitwriter','transformutils'],text=True))
digest=hashlib.sha256(source.read_bytes()+str(flags).encode()).hexdigest()
exe=scratch/f'check-{sys.argv[1]}-{digest}'
if not exe.exists():
    temporary=exe.with_suffix(f'.{os.getpid()}.new')
    subprocess.run([llvm/'clang++','-O2',source,*flags,'-o',temporary],check=True)
    temporary.replace(exe)
subprocess.run([exe,sys.argv[2],sys.argv[3]],check=True)
