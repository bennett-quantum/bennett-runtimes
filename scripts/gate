#!/usr/bin/env python3
"""Default bounded tests; --all is the complete publication/push suite."""
import argparse
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import tomllib

ROOT = Path(__file__).resolve().parents[1]

def reproduce():
    with tempfile.TemporaryDirectory(prefix='reproduce-', dir=os.environ['TMPDIR']) as directory:
        for major in (18, 23):
            out = Path(directory)/f'llvm{major}'
            subprocess.run([ROOT/'scripts/build', str(major), out], check=True, timeout=240)
            baseline = ROOT/f'dist/llvm{major}'
            expected = {p.relative_to(baseline) for p in baseline.rglob('*') if p.is_file()}
            actual = {p.relative_to(out) for p in out.rglob('*') if p.is_file()}
            assert expected == actual, (major, expected ^ actual)
            for name in sorted(expected):
                subprocess.run(['cmp', baseline/name, out/name], check=True)

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    group = parser.add_mutually_exclusive_group()
    for mode in ('fast', 'slow', 'all', 'promised'):
        group.add_argument('--'+mode, action='store_const', dest='mode', const=mode)
    parser.add_argument('--list', choices=('fast', 'slow', 'promised'))
    args = parser.parse_args()
    suites = tomllib.loads((ROOT/'tests/suites.toml').read_text())
    if args.list:
        print('\n'.join(suites[args.list]))
        return
    for key in ('GIT_DIR', 'GIT_WORK_TREE', 'GIT_INDEX_FILE', 'DISPLAY',
                'WAYLAND_DISPLAY', 'DBUS_SESSION_BUS_ADDRESS', 'BROWSER'):
        os.environ.pop(key, None)
    os.environ.setdefault('TMPDIR', str(ROOT/'.tmp/tests'))
    Path(os.environ['TMPDIR']).mkdir(parents=True, exist_ok=True)
    mode = args.mode or 'fast'
    if mode == 'all':
        reproduce()
    names = suites['fast']+suites['slow'] if mode == 'all' else suites[mode]
    for name in names:
        subprocess.run([sys.executable, '-I', ROOT/'tests'/name], check=True, timeout=1800)
    if mode != 'promised':
        subprocess.run([sys.executable, '-I', ROOT/'tests/test_promised_helpers.py', '--report'], check=True)
    print(f'gate: {mode} suite PASS (LLVM 18/23)')

if __name__ == '__main__':
    main()
