#!/usr/bin/env bash
set -euo pipefail
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE DISPLAY WAYLAND_DISPLAY DBUS_SESSION_BUS_ADDRESS BROWSER
root="$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")"
export TMPDIR="$root/.tmp"
mkdir -p "$TMPDIR"
rebuild="$(mktemp -d "$TMPDIR/reproduce-XXXXXXXX")"
trap 'rm -rf "$rebuild"' EXIT
for major in 18 23; do
  "$root/scripts/build" "$major" "$rebuild/llvm$major"
  for name in bennett-runtimes.bc bennett-runtimes-native.bc sanitizer-support.bc libclang_rt.ubsan_minimal-x86_64.a COMPILER-RT-COPYRIGHT COMPILER-RT-LICENSE manifest.json SHA256SUMS; do
    cmp "$root/dist/llvm$major/$name" "$rebuild/llvm$major/$name"
  done
  diff -r "$root/dist/llvm$major/musl-sysroot" "$rebuild/llvm$major/musl-sysroot"
done
python3 -I "$root/tests/test_reproducibility.py"
python3 -I "$root/tests/test_alignment.py"
python3 -I "$root/tests/test_runtime.py"
python3 -I "$root/tests/test_publication.py"
python3 -I "$root/tests/test_musl.py"
python3 -I "$root/tests/test_native.py"
python3 -I "$root/tests/test_checked_native.py"
python3 -I "$root/tests/test_fenv.py"
python3 -I "$root/tests/test_console.py"
python3 -I "$root/tests/test_sanitizers.py"
echo 'gate: LLVM 18/23 publications reproduced; runtime and corpus closure PASS'
